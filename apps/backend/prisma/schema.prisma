generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  github      String?
  linkedin    String?
  portfolio   String?
  skills      Skill[]
  experiences Experience[]
  projects    Project[]

  @@map("profiles")
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Experience {
  id           Int     @id @default(autoincrement())
  company      String
  position     String
  period       String
  achievements String?
  profileId    Int
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Project {
  id        Int    @id @default(autoincrement())
  name      String
  url       String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}